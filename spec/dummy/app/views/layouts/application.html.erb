<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>datatables-factory demo</title>
    <%= csrf_meta_tags %>

    <!-- CSS servis depuis public/ -->
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
    <link rel="stylesheet" href="<%= datatables_bundle_css_path %>">
    <link rel="stylesheet" href="/stylesheets/tom-select.bootstrap5.min.css">
    <link rel="stylesheet" href="/stylesheets/nouislider.min.css">
    <link rel="stylesheet" href="/stylesheets/jquery-ui.css">
    <!-- Font Awesome (icons, CDN) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- Scripts dans le <head>, comme les packs de l'application hôte : Turbo
         fusionne le head et ne réévalue pas ces balises, donc la bibliothèque
         et les classes de démo ne sont chargées qu'une fois. Les mettre dans le
         <body> les ferait rejouer à chaque navigation, ce qui recréerait les
         classes JS et masquerait le cycle destroy/recréation des tables. -->
    <script src="/javascripts/turbo.min.js"></script>
    <script src="<%= jquery_js_path %>"></script>
    <script src="<%= datatables_bundle_js_path %>"></script>
    <script src="/javascripts/tom-select.min.js"></script>
    <script src="/javascripts/jquery-ui.min.js"></script>
    <script src="/javascripts/nouislider.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- datatables-factory (servi par l'engine via asset pipeline) -->
    <%= javascript_include_tag 'datatables-factory', defer: false %>

    <!-- Équivalent du pack applicatif : classes de démo + init sur turbo:load -->
    <script src="/javascripts/dummy_datatables.js"></script>

    <style>
      body { background-color: #f8f9fa; }
      .sidebar { min-height: calc(100vh - 56px); background: #fff; border-right: 1px solid #dee2e6; }
      .sidebar .nav-link { color: #495057; border-radius: 6px; }
      .sidebar .nav-link:hover { background: #f8f9fa; }
      .sidebar .nav-link.active { background: #0d6efd; color: #fff; }
      .sidebar .badge { font-size: .65rem; }
      .feature-card { border: none; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
      .dtf-filter { border-radius: 6px; }
      .dtf-filter-icon { background: #f8f9fa; }
      /* Filters — empêche le retour à la ligne dans l'input-group */
      .dtf-filter-wrapper .input-group { flex-wrap: nowrap; }
      .dtf-filter-wrapper-inner {
        display: flex !important;
        flex: 1 1 0 !important;
        min-width: 0;
        gap: 0.25rem;
        overflow: hidden;
      }
      .dtf-filter-range {
        flex: 1 1 0% !important;
        min-width: 0 !important;
        width: 0 !important;
      }
      .dtf-filter-range-number-separator,
      .dtf-filter-range-date-separator {
        align-self: center;
        color: #6c757d;
        padding: 0 2px;
        flex-shrink: 0;
      }
    </style>
  </head>
  <body data-dt-version="<%= datatables_version %>" data-jquery-version="<%= jquery_version %>">
    <%= render 'shared/navbar' %>

    <div class="container-fluid">
      <div class="row">
        <nav class="col-lg-2 d-none d-lg-block sidebar py-3 ps-3 pe-2">
          <%= render 'shared/sidebar' %>
        </nav>

        <main class="col-lg-10 py-4 px-4">
          <%= yield %>
        </main>
      </div>
    </div>

    <%= yield :javascript %>
  </body>
</html>
