<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>datatables-factory demo</title>
    <%= csrf_meta_tags %>

    <!-- CSS servis depuis public/ -->
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/datatables.bundle.min.css">
    <link rel="stylesheet" href="/stylesheets/tom-select.bootstrap5.min.css">
    <link rel="stylesheet" href="/stylesheets/jquery-ui.css">
    <!-- Font Awesome (icons, CDN) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
      body { background-color: #f8f9fa; }
      .sidebar { min-height: calc(100vh - 56px); background: #fff; border-right: 1px solid #dee2e6; }
      .sidebar .nav-link { color: #495057; border-radius: 6px; }
      .sidebar .nav-link:hover { background: #f8f9fa; }
      .sidebar .nav-link.active { background: #0d6efd; color: #fff; }
      .sidebar .badge { font-size: .65rem; }
      .feature-card { border: none; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
      .yadcf-filter { border-radius: 6px; }
      .dtf-filter-icon { background: #f8f9fa; }
      /* Filters — empêche le retour à la ligne dans l'input-group */
      .yadcf-filter-wrapper .input-group { flex-wrap: nowrap; }
      .yadcf-filter-wrapper-inner {
        display: flex !important;
        flex: 1 1 0 !important;
        min-width: 0;
        gap: 0.25rem;
        overflow: hidden;
      }
      .yadcf-filter-range {
        flex: 1 1 0% !important;
        min-width: 0 !important;
        width: 0 !important;
      }
      .yadcf-filter-range-number-seperator,
      .yadcf-filter-range-date-seperator {
        align-self: center;
        color: #6c757d;
        padding: 0 2px;
        flex-shrink: 0;
      }
    </style>
  </head>
  <body>
    <%= render 'shared/navbar' %>

    <div class="container-fluid">
      <div class="row">
        <nav class="col-lg-2 d-none d-lg-block sidebar py-3 ps-3 pe-2">
          <%= render 'shared/sidebar' %>
        </nav>

        <main class="col-lg-10 py-4 px-4">
          <%= yield %>
        </main>
      </div>
    </div>

    <!-- jQuery + DataTables bundle + tom-select (servis depuis public/) -->
    <script src="/javascripts/jquery.min.js"></script>
    <script src="/javascripts/datatables.bundle.min.js"></script>
    <script src="/javascripts/tom-select.min.js"></script>
    <!-- jQuery UI (servi localement) -->
    <script src="/javascripts/jquery-ui.min.js"></script>
    <!-- Bootstrap 5 JS (CDN, non-critique pour les tests) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- datatables-factory (servi par l'engine via asset pipeline) -->
    <%= javascript_include_tag 'datatables-factory', defer: false %>
    <script>
      // Le bundle UMD expose l'objet d'exports nommés { DatatableBase }
      // (équivalent de `import { DatatableBase } from '@jbox-web/datatables-factory'`,
      // tel que consommé par concerto). On en extrait la classe pour l'exposer
      // en global, attendu par les scripts de démo ci-dessous.
      window.DatatableBase = window.DatatableBase.DatatableBase
    </script>

    <%= yield :javascript %>
  </body>
</html>
