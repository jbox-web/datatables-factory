<div class="d-flex align-items-center mb-4">
  <h2 class="h4 mb-0 fw-semibold">
    <i class="fa-solid fa-user me-2 text-primary"></i><%= @user.first_name %> <%= @user.last_name %>
  </h2>
  <div class="ms-auto d-flex gap-2">
    <%= link_to edit_user_path(@user), class: 'btn btn-sm btn-outline-secondary' do %>
      <i class="fa-solid fa-pen me-1"></i>Éditer
    <% end %>
    <%= button_to user_path(@user), method: :delete, form: { data: { confirm: 'Supprimer cet utilisateur ?' } }, class: 'btn btn-sm btn-outline-danger' do %>
      <i class="fa-solid fa-trash me-1"></i>Supprimer
    <% end %>
    <%= link_to context_menu_path, class: 'btn btn-sm btn-light' do %>
      <i class="fa-solid fa-arrow-left me-1"></i>Retour
    <% end %>
  </div>
</div>

<div class="card feature-card">
  <div class="card-body p-4">
    <dl class="row mb-0">
      <dt class="col-sm-3">First name</dt>
      <dd class="col-sm-9"><%= @user.first_name %></dd>

      <dt class="col-sm-3">Last name</dt>
      <dd class="col-sm-9"><%= @user.last_name %></dd>

      <dt class="col-sm-3">Email</dt>
      <dd class="col-sm-9"><%= @user.email %></dd>

      <dt class="col-sm-3">Role</dt>
      <dd class="col-sm-9"><span class="badge bg-secondary"><%= @user.role %></span></dd>

      <dt class="col-sm-3">Age</dt>
      <dd class="col-sm-9"><%= @user.age %></dd>

      <dt class="col-sm-3">Created at</dt>
      <dd class="col-sm-9"><%= @user.created_at.strftime('%d/%m/%Y') %></dd>
    </dl>
  </div>
</div>
