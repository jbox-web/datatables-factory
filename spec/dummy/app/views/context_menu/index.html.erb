<div class="d-flex align-items-center mb-3">
  <h2 class="h4 mb-0 fw-semibold">
    <i class="fa-solid fa-computer-mouse me-2 text-primary"></i>Context menu
  </h2>
  <span class="badge bg-light text-dark border ms-3">clic droit · long-press mobile · checkboxes</span>
</div>
<p class="text-muted mb-4">
  Faites un <strong>clic droit</strong> sur n'importe quelle ligne pour ouvrir le menu contextuel.
  Sur mobile, un <strong>appui long</strong> (~500ms) produit le même effet.
  La colonne checkbox permet aussi la sélection multi-lignes.
</p>

<div id="context-menu" class="dropdown-menu shadow" style="display:none; position:fixed; z-index:9999;"></div>

<div class="card feature-card">
  <div class="card-body p-4">
    <%
      dt = bootstrap_datatables_for(
        :context_menu,
        source: api_context_menu_datatable_path,
        serverSide: true,
        stateSave: false,
        select: { style: 'multi' },
        order: [[1, 'asc']],
        dtf_options: { context_menu: true },
      ) do |dt|
        dt.head_for_check_box
        dt.head_for :first_name, label: 'First name'
        dt.head_for :last_name,  label: 'Last name'
        dt.head_for :email,      label: 'Email'
        dt.head_for :role,       label: 'Role', sortable: false
        dt.body class: 'context-menu', data: { url: context_menu_menu_path }
      end
    %>
    <%= dt.render_datatable %>
  </div>
</div>

